{
  "expo": {
    "name": "OpoCompit",
    "slug": "opocompit",
    "version": "0.1.0",
    "description": "Oposiciones convertidas en partidas útiles, sociales y competitivas.",
    "orientation": "portrait",
    "scheme": "opocompit",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFCF8",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.opocompit.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFCF8"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFCF8",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
